-- Core logic
local function applyTo(part, size, transparency)
    part.Size = Vector3.new(size, size, size)
    part.Transparency = transparency
    part.CanCollide = false
end

local function clearConnections()
    for _, c in ipairs(connections) do
        c:Disconnect()
    end
    connections = {}
end

local function isWhitelisted(modelName)
    return modelName == localUsername or whitelistedPlayers[modelName] == true
end

-- Add a separate check:
local function isExcluded(modelName)
    return excludedNPCs[modelName] == true
end

local function restoreModel(model)
    if not model:IsA("Model") then return end
    if isExcluded(model.Name) then return end
    local head = model:FindFirstChild("Head")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if head then
        head.Size = Vector3.new(2, 1, 1)
        head.Transparency = 0
        head.CanCollide = true
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("SpecialMesh") then
                child.Scale = Vector3.new(1, 1, 1)
            end
        end
    end
    if hrp then
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = true
    end
end

local function processModel(model, size, transparency)
    if not model:IsA("Model") then return end
    if isWhitelisted(model.Name) then
        restoreModel(model)
        return
    end
    if isExcluded(model.Name) then return end
    local head = model:FindFirstChild("Head")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if head then
        head.Size = Vector3.new(size, size, size)
        head.CanCollide = false
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("SpecialMesh") then
                child.Scale = Vector3.new(0, 0, 0)
            end
        end
    end
    if hrp then applyTo(hrp, size, transparency) end
    local childConn = model.ChildAdded:Connect(function(child)
        if not hitboxEnabled then return end
        if isWhitelisted(model.Name) then
            restoreModel(model)
            return
        end
        if child.Name == "Head" then
            child.Size = Vector3.new(currentSize, currentSize, currentSize)
            child.CanCollide = false
            for _, c in ipairs(child:GetChildren()) do
                if c:IsA("SpecialMesh") then
                    c.Scale = Vector3.new(0, 0, 0)
                end
            end
        elseif child.Name == "HumanoidRootPart" then
            applyTo(child, currentSize, currentTransparency)
        end
    end)
    table.insert(connections, childConn)
end

local function enableHitboxes(size, transparency)
    local entitiesFolder = workspace:FindFirstChild("Entities")
    if not entitiesFolder then
        warn("Entities folder not found.")
        return
    end
    clearConnections()
    for _, model in ipairs(entitiesFolder:GetChildren()) do
        processModel(model, size, transparency)
    end
    local folderConn = entitiesFolder.ChildAdded:Connect(function(child)
        if hitboxEnabled then
            processModel(child, currentSize, currentTransparency)
        end
    end)
    table.insert(connections, folderConn)
end

local function disableHitboxes()
    clearConnections()
    local entitiesFolder = workspace:FindFirstChild("Entities")
    if not entitiesFolder then return end
    for _, model in ipairs(entitiesFolder:GetChildren()) do
        restoreModel(model)
    end
end

local function refreshHitboxes()
    if hitboxEnabled then
        enableHitboxes(currentSize, currentTransparency)
    end
end

local function fireWardenPickup(wardenModel)
    local hitbox = wardenModel:FindFirstChild("Hitbox")
    if not hitbox then return end
    local ti = hitbox:FindFirstChild("TouchInterest")
    if not ti then return end
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    firetouchinterest(hrp, hitbox, 0) -- touch begin
    task.wait(0.1)
    firetouchinterest(hrp, hitbox, 1) -- touch end
    print("Warden pickup fired!")
end

local function startWardenWatch()
    local gameObjects = workspace:WaitForChild("GameObjects", 10)
    if not gameObjects then return end
    local drops = gameObjects:WaitForChild("Drops", 10)
    if not drops then return end

    -- Check if already exists
    local existing = drops:FindFirstChild("Warden")
    if existing and wardenAutoPickup then
        fireWardenPickup(existing)
    end

    wardenWatchConn = drops.ChildAdded:Connect(function(child)
        if child.Name == "Warden" and wardenAutoPickup then
            task.wait(0.1) -- let it fully load
            fireWardenPickup(child)
        end
    end)
end

