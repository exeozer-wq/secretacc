-- Helper: Get list of current player names in server (excluding self)
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name ~= localUsername then
            table.insert(names, p.Name)
        end
    end
    return names
end

-- Helper: Build display label for current whitelist
local whitelistLabel = nil

local function updateWhitelistLabel()
    local names = {}
    for name, _ in pairs(whitelistedPlayers) do
        table.insert(names, name)
    end
    local display = #names > 0 and table.concat(names, ", ") or "None"
    if whitelistLabel then
        pcall(function()
            whitelistLabel.Label.Text = "Whitelisted: " .. display
        end)
    end
end
-- Input: manually type a username to whitelist
WhitelistTab:CreateInput({
    Name = "Add Player to Whitelist",
    PlaceholderText = "Enter exact username",
    RemoveTextAfterFocusLost = true,
    Callback = function(text)
        if text and text ~= "" then
            local trimmed = text:match("^%s*(.-)%s*$")
            if trimmed ~= "" then
                whitelistedPlayers[trimmed] = true
                updateWhitelistLabel()
                refreshHitboxes()
                Rayfield:Notify({
                    Title = "Whitelist",
                    Content = trimmed .. " has been whitelisted.",
                    Duration = 3,
                    Image = 4483362458,
                })
            end
        end
    end,
})

-- Input: remove a player from whitelist
WhitelistTab:CreateInput({
    Name = "Remove Player from Whitelist",
    PlaceholderText = "Enter exact username",
    RemoveTextAfterFocusLost = true,
    Callback = function(text)
        if text and text ~= "" then
            local trimmed = text:match("^%s*(.-)%s*$")
            if trimmed ~= "" and whitelistedPlayers[trimmed] then
                whitelistedPlayers[trimmed] = nil
                updateWhitelistLabel()
                refreshHitboxes()
                Rayfield:Notify({
                    Title = "Whitelist",
                    Content = trimmed .. " has been removed from whitelist.",
                    Duration = 3,
                    Image = 4483362458,
                })
            else
                Rayfield:Notify({
                    Title = "Whitelist",
                    Content = trimmed .. " was not in the whitelist.",
                    Duration = 3,
                    Image = 4483362458,
                })
            end
        end
    end,
})

-- Dropdown: quick-select from players currently in the server to whitelist
local function buildPlayerDropdown()
    local playerNames = getPlayerNames()
    if #playerNames == 0 then
        playerNames = {"No other players found"}
    end

    WhitelistTab:CreateDropdown({
        Name = "Quick-Add Player (Server List)",
        Options = playerNames,
        CurrentOption = {playerNames[1]},
        Flag = "WhitelistDropdown",
        MultipleOptions = true,
        Callback = function(selected)
			-- Normalize: ensure selected is always a table
			if type(selected) == "string" then
				selected = {selected}
			end

			local currentServerPlayers = {}
			for _, name in ipairs(getPlayerNames()) do
				currentServerPlayers[name] = true
			end

			for name, _ in pairs(currentServerPlayers) do
				if not table.find(selected, name) then
					whitelistedPlayers[name] = nil
				end
			end

			for _, name in ipairs(selected) do
				if name ~= "No other players found" then
					whitelistedPlayers[name] = true
				end
			end

			updateWhitelistLabel()
			refreshHitboxes()
		end,
    })
end

