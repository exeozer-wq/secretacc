-- ─────────────────────────────────────────────
-- Auto Farm Core Loop
-- Priority order when bossPriorityOn:
--   1. Look for any selected boss (auto-spawned always checked; manual only if found)
--   2. Fall back to selected mob group
-- When bossPriorityOn is OFF: only attack selected mob group.
-- ─────────────────────────────────────────────
local function waitForNPC(npcName, timeout)
    local deadline = tick() + (timeout or 4)
    repeat
        local ok, children = pcall(function() return workspace.NPCs:GetChildren() end)
        if ok then
            for _, child in ipairs(children) do
                local bossId = child:GetAttribute("BossId")
                local matchByBossId = bossId == npcName
                local matchByName = child.Name:find("^" .. npcName)
                if (matchByBossId or matchByName) and isNPCAlive(child) then
                    return child
                end
            end
        end
        task.wait(0.2)
    until tick() > deadline
    return nil
end

local function runAutoFarm(session)
    print("[AutoFarm] Started | session=" .. session)

    -- Quick presence check: is the boss model in workspace.NPCs right now?
    local function bossExistsAnywhere(npcName)
        local ok, children = pcall(function() return workspace.NPCs:GetChildren() end)
        if not ok then return false, nil, nil end
        for _, child in ipairs(children) do
            local bossId = child:GetAttribute("BossId")
            -- check BOTH BossId attribute AND name prefix
            if (bossId == npcName or child.Name:find("^" .. npcName)) and isNPCAlive(child) then
                local spawnId = getBossSpawnId(child)
                return true, child, spawnId
            end
        end
        return false, nil, nil
    end

    -- Full teleport: fire remote repeatedly, wait for position to stabilise
    local function doTeleport(islandName)
        print("[AutoFarm] Teleporting to: " .. islandName)
        for _ = 1, 6 do
            fireTeleport(islandName)
            task.wait(0.4)
        end
        currentTrackedIsland = islandName
        -- wait for position to stabilise
        local root = getPlayerRoot()
        if root then
            local lastPos = root.Position
            local stable = 0
            for _ = 1, 30 do
                task.wait(0.1)
                root = getPlayerRoot()
                if not root then break end
                if (root.Position - lastPos).Magnitude < 1 then
                    stable += 1
                    if stable >= 5 then break end
                else
                    stable = 0
                    lastPos = root.Position
                end
            end
        end
        task.wait(0.8) -- small extra buffer for NPCs to replicate
    end

    -- Tween to hover above a position, returns true when done
    local function tweenToHover(targetPos, heightOffset, speed)
        local root = getPlayerRoot()
        if not root then return false end
        heightOffset = heightOffset or 70
        speed        = speed        or 120
        local dest   = Vector3.new(targetPos.X, targetPos.Y + heightOffset, targetPos.Z)
        local dist   = (root.Position - dest).Magnitude
        local dur    = math.max(dist / speed, 0.3)
        print(string.format("[AutoFarm] Tweening %.0f studs | %.2fs", dist, dur))
        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
        activeTween = TweenService:Create(root,
            TweenInfo.new(dur, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(dest) }
        )
        pcall(function() activeTween:Play() end)
        task.wait(dur)
        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
        return true
    end

    while autoFarmEnabled and farmSession == session do

        -- ═══════════════════════════════════════════════════════════════
        -- BOSS PRIORITY: Step 1 — fast presence check (no teleport yet)
        -- ═══════════════════════════════════════════════════════════════
        local liveBoss    = nil
        local liveBossCfg = nil

        -- Re-read pity every iteration when pity farm is active
        if pityFarmEnabled then
            local text   = getPityText()
            local parsed = parsePity(text)
            if parsed ~= nil then currentPity = parsed end
        end

        -- Build the list of boss keys to check this iteration
        local bossKeysThisIteration = {}

        if bossPriorityOn and #selectedBossKeys > 0 then
            for _, k in ipairs(selectedBossKeys) do
                table.insert(bossKeysThisIteration, k)
            end
        end

        -- Pity farm: at 24/25, ONLY target the pity boss (guaranteed drop kill)
        if pityFarmEnabled and selectedPityBoss then
            if currentPity ~= nil and currentPity >= 24 then
                -- Override everything — only the pity boss matters now
                bossKeysThisIteration = { selectedPityBoss }

                -- Check if it's alive
                local cfg = BOSS_MAP[selectedPityBoss]
                if cfg then
                    local pityNPC = findLivePityBoss()
                    if not pityNPC then
                        -- Boss dead/not spawned — notify once and wait
                        if not pityBossWatching then
                            pityBossWatching = true
                            WindUI:Notify({
                                Title    = "Pity Farm",
                                Content  = "24/25 — waiting for " .. cfg.display .. " to spawn. Farming mobs.",
                                Icon     = "clock",
                                Duration = 6,
                            })
                        end
                        -- Fall through to mob farm below
                        bossKeysThisIteration = {}
                    else
                        pityBossWatching = false
                    end
                end
            else
                pityBossWatching = false
                -- Below 24/25: add pity boss to the check list if not already there
                if not table.find(bossKeysThisIteration, selectedPityBoss) then
                    table.insert(bossKeysThisIteration, selectedPityBoss)
                end
            end
        end

        if #bossKeysThisIteration > 0 then
            for _, bossKey in ipairs(bossKeysThisIteration) do
                if not (autoFarmEnabled and farmSession == session) then break end
                local cfg = BOSS_MAP[bossKey]
                if not cfg then continue end

                local exists, roughNPCCheck, roughSpawnId = bossExistsAnywhere(cfg.npcName)
                if not exists then
                    print("[AutoFarm] Boss model absent, skipping: " .. cfg.display)
                    continue
                end

                local currentSpawnId = roughSpawnId or cfg.npcName
                if thresholdSkipped[currentSpawnId] then
                    -- For the pity boss at 24/25, never skip — clear threshold and re-engage
                    if pityFarmEnabled and bossKey == selectedPityBoss and currentPity ~= nil and currentPity >= 24 then
                        print("[AutoFarm] Pity 24/25 — clearing threshold skip for: " .. currentSpawnId)
                        thresholdSkipped[currentSpawnId] = nil
                    else
                        print("[AutoFarm] Threshold-skipped: " .. currentSpawnId)
                        continue
                    end
                end

                if currentTrackedIsland ~= cfg.island then
                    doTeleport(cfg.island)
                    if not (autoFarmEnabled and farmSession == session) then break end
                end

                local roughNPC = nil
                local roughSpawnId2 = nil
                for _, child in ipairs(workspace.NPCs:GetChildren()) do
                    local bossId = child:GetAttribute("BossId")
                    if bossId == cfg.npcName or child.Name:find("^" .. cfg.npcName) then
                        roughNPC = child
                        roughSpawnId2 = getBossSpawnId(child)
                        break
                    end
                end
                local roughPos = nil
                if roughNPC then
                    local ok, pos = pcall(function() return roughNPC:GetPivot().Position end)
                    if ok and pos then roughPos = pos end
                end
                if roughPos then
                    local root = getPlayerRoot()
                    if root then
                        local startPos = root.Position
                        local destPos  = Vector3.new(roughPos.X, roughPos.Y + 70, roughPos.Z)
                        local STEPS    = 3
                        for i = 1, STEPS do
                            if not (autoFarmEnabled and farmSession == session) then break end
                            root = getPlayerRoot()
                            if not root then break end
                            local alpha    = i / STEPS
                            local stepDest = startPos:Lerp(destPos, alpha)
                            local stepDist = (root.Position - stepDest).Magnitude
                            local stepDur  = math.max(stepDist / 120, 0.3)
                            if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
                            activeTween = TweenService:Create(root,
                                TweenInfo.new(stepDur, Enum.EasingStyle.Linear),
                                { CFrame = CFrame.new(stepDest) }
                            )
                            pcall(function() activeTween:Play() end)
                            task.wait(stepDur + 0.3)
                            if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
                        end
                    end
                    if not (autoFarmEnabled and farmSession == session) then break end
                end

                local npc = waitForNPC(cfg.npcName, 5)
                if npc then
                    liveBoss    = npc
                    liveBossCfg = cfg
                    trackBossDeath(npc, cfg.npcName)
                    print("[AutoFarm] Live boss confirmed: " .. cfg.display)
                    break
                end
            end
        end

        -- ═══════════════════════════════════════════════════════════════
        -- BOSS ATTACK
        -- ═══════════════════════════════════════════════════════════════
        if liveBoss and liveBossCfg then
            if not (autoFarmEnabled and farmSession == session) then continue end
            local cfg = liveBossCfg
            local npc = liveBoss

            local finalPos = getNPCPosition(npc)
            if finalPos then
                tweenToHover(finalPos, 70, 120)
                if not (autoFarmEnabled and farmSession == session) then stopHover(); continue end
                startHover(function() return getNPCPosition(npc) end)
                task.wait(0.5)
                if not (autoFarmEnabled and farmSession == session) then stopHover(); continue end
                print("[AutoFarm] Attacking boss: " .. cfg.npcName)
                -- At pity 24/25, always fully kill regardless of threshold setting
                local isPityKill = pityFarmEnabled and liveBossCfg.key == selectedPityBoss
                    and currentPity ~= nil and currentPity >= 24
                if isPityKill then
                    local savedThreshold = bossHPThreshold
                    bossHPThreshold = 100
                    runAttackLoop(npc, session, true, cfg.npcName)
                    bossHPThreshold = savedThreshold
                    -- Re-read pity after the kill
                    task.wait(1.5)
                    local newPity = parsePity(getPityText())
                    if newPity ~= nil then
                        currentPity = newPity
                        print("[AutoFarm] Pity after kill: " .. tostring(currentPity))
                    end
                else
                    runAttackLoop(npc, session, true, cfg.npcName)
                end
                print("[AutoFarm] Boss loop ended: " .. cfg.npcName)
            end
            task.wait(3.5)
            stopHover()
            task.wait(0.3)

        -- ═══════════════════════════════════════════════════════════════
        -- MOB FARM
        -- ═══════════════════════════════════════════════════════════════
        elseif selectedMobGroup then
            if not (autoFarmEnabled and farmSession == session) then continue end
            print("[AutoFarm] Mob farming: " .. tostring(selectedMobGroup))
            local npcNames = groups[selectedMobGroup]
            local didAttack = false

            if npcNames then
                local foundMob = nil
                for _, npcName in ipairs(npcNames) do
                    if not (autoFarmEnabled and farmSession == session) then break end
                    local npc = findLiveNPC(npcName)
                    if npc then foundMob = { name = npcName, npc = npc }; break end
                end

                if foundMob then
                    local npcName = foundMob.name
                    local npc     = foundMob.npc

                    local targetIsland = getIslandFromNPCName(npcName)
                    if targetIsland and currentTrackedIsland ~= targetIsland then
                        doTeleport(targetIsland)
                        if not (autoFarmEnabled and farmSession == session) then continue end
                        npc = waitForNPC(npcName, 5)
                        if not npc then
                            print("[AutoFarm] Mob gone after teleport: " .. npcName)
                            currentTrackedIsland = nil
                        end
                    end

                    if npc and (autoFarmEnabled and farmSession == session) then
                        local npcPos = getNPCPosition(npc)
                        if npcPos then
                            tweenToHover(npcPos, 70, 120)
                            if not (autoFarmEnabled and farmSession == session) then continue end

                            -- Re-find mob after tween — it may have moved or respawned
                            npc = findLiveNPC(npcName)
                            if not npc then
                                -- Try waitForNPC as fallback
                                npc = waitForNPC(npcName, 3)
                            end

                            if npc then
                                local finalPos = getNPCPosition(npc)
                                if finalPos then
                                    -- Snap directly on top of the confirmed live position
                                    local root = getPlayerRoot()
                                    if root then
                                        root.CFrame = CFrame.new(Vector3.new(finalPos.X, finalPos.Y + 70, finalPos.Z))
                                    end
                                    startHover(function() return getNPCPosition(npc) end)
                                    task.wait(0.5)
                                    if not (autoFarmEnabled and farmSession == session) then stopHover(); continue end
                                    print("[AutoFarm] Attacking mob: " .. npcName)
                                    runAttackLoop(npc, session, false, npcName)
                                    print("[AutoFarm] Mob loop ended: " .. npcName)
                                    stopHover()
                                    task.wait(0.3)
                                    didAttack = true
                                end
                            else
                                print("[AutoFarm] Mob died during travel: " .. npcName)
                            end
                        end
                    end
                end
            end

            if not didAttack then
                print("[AutoFarm] Nothing to attack, waiting...")
                task.wait(0.7)
            end

        else
            print("[AutoFarm] Nothing selected, waiting...")
            task.wait(0.7)
        end

        if autoFarmEnabled and farmSession == session then
            task.wait(1)
        end
    end

    print("[AutoFarm] Stopped | session=" .. session)
    stopHover()
    if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
end

