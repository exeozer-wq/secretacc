local mobAuraEnabled = false
local playerAuraEnabled = false

Tab:CreateToggle({
    Name = "Mob Aura",
    CurrentValue = false,
    Flag = "MobAura",
    Callback = function(value)
        mobAuraEnabled = value
        if mobAuraEnabled then
            task.spawn(function()
                while mobAuraEnabled do
                    local character = LocalPlayer.Character
                    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
                    if playerRoot then
                        for _, npc in ipairs(workspace.NPCs:GetChildren()) do
                            if not mobAuraEnabled then break end
                            local humanoid = npc:FindFirstChildOfClass("Humanoid")
                            if not humanoid or humanoid.Health <= 0 then continue end
                            local npcRoot = getNPCRoot(npc)
                            if not npcRoot then continue end
                            local dist = (playerRoot.Position - npcRoot.Position).Magnitude
                            if dist <= 200 then
                                local pos = npcRoot.Position
                                RequestHit:FireServer(Vector3.new(pos.X, pos.Y, pos.Z))
                            end
                        end
                    end
                    task.wait(0.35)
                end
            end)
        end
    end,
})

Tab:CreateToggle({
    Name = "Player Aura",
    CurrentValue = false,
    Flag = "PlayerAura",
    Callback = function(value)
        playerAuraEnabled = value
        if playerAuraEnabled then
            task.spawn(function()
                while playerAuraEnabled do
                    local character = LocalPlayer.Character
                    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
                    if playerRoot then
                        for _, player in ipairs(Players:GetPlayers()) do
                            if not playerAuraEnabled then break end
                            if player == LocalPlayer then continue end
                            local targetChar = player.Character
                            if not targetChar then continue end
                            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                            if not targetRoot then continue end
                            local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                            if not humanoid or humanoid.Health <= 0 then continue end
                            local dist = (playerRoot.Position - targetRoot.Position).Magnitude
                            if dist <= 200 then
                                local pos = targetRoot.Position
                                RequestHit:FireServer(Vector3.new(pos.X, pos.Y, pos.Z))
                            end
                        end
                    end
                    task.wait(0.35)
                end
            end)
        end
    end,
})

-- Stats Tab
local StatsTab = Window:CreateTab("Stats", nil)

local selectedStat = "Melee"
local statAmount = 1
local autoStatEnabled = false

local AllocateStat = RemoteEvents:WaitForChild("AllocateStat")

StatsTab:CreateDropdown({
    Name = "Stat",
    Options = {"Melee", "Defense", "Sword", "Power"},
    CurrentOption = {"Melee"},
    MultipleOptions = false,
    Flag = "StatDropdown",
    Callback = function(selected)
        selectedStat = selected[1] or "Melee"
    end,
})

StatsTab:CreateInput({
    Name = "Amount",
    CurrentValue = "1",
    PlaceholderText = "Enter amount",
    RemoveTextAfterFocusLost = false,
    Flag = "StatAmount",
    Callback = function(value)
        local num = tonumber(value)
        if num and num > 0 then
            statAmount = math.floor(num)
        end
    end,
})

StatsTab:CreateToggle({
    Name = "Auto Stat",
    CurrentValue = false,
    Flag = "AutoStat",
    Callback = function(value)
        autoStatEnabled = value
        if autoStatEnabled then
            task.spawn(function()
                while autoStatEnabled do
                    AllocateStat:FireServer(selectedStat, statAmount)
                    task.wait(0.1)
                end
            end)
        end
    end,
})
