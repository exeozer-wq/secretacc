local function isNPCValid(npc)
    if not npc then return false end
    local ok, res = pcall(function() return npc.Parent ~= nil end)
    return ok and res == true
end

local function isNPCAlive(npc)
    if not isNPCValid(npc) then return false end
    local ok, res = pcall(function()
        local h = npc:FindFirstChildOfClass("Humanoid")
        return h and h.Health > 0
    end)
    return ok and res == true
end

local function getNPCPosition(npc)
    if not isNPCValid(npc) then return nil end
    local ok, res = pcall(function()
        local root = npc:FindFirstChild("HumanoidRootPart")
            or npc:FindFirstChild("PrimaryPart")
            or npc:FindFirstChildWhichIsA("BasePart")
        return root and root.Position or nil
    end)
    return (ok and res) or nil
end

local function getPlayerRoot()
    local ok, res = pcall(function()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end)
    return (ok and res) or nil
end

local function getIslandForPosition(pos)
    return currentTrackedIsland
end

local function getIslandFromNPCName(npcName)
    local lower = npcName:lower()
    for hint, island in pairs(NPC_ISLAND_HINTS) do
        if lower:find(hint) then return island end
    end
    return nil
end


local function waitForRespawn(timeout)
    local deadline = tick() + (timeout or 6)
    local root
    repeat task.wait(0.5); root = getPlayerRoot() until root or tick() > deadline
    return root
end

local function fireHit(pos)
    pcall(function() RequestHit:FireServer(Vector3.new(pos.X, pos.Y, pos.Z)) end)
end

local function getBackpackTools()
    local tools = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then table.insert(tools, tool.Name) end
        end
    end
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then table.insert(tools, tool.Name) end
        end
    end
    table.sort(tools)
    return tools
end

local function equipTool(toolName)
    if not toolName then return end
    local character = LocalPlayer.Character
    local backpack  = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return end

    -- Already equipped
    local equipped = character:FindFirstChildWhichIsA("Tool")
    if equipped and equipped.Name == toolName then return end

    -- Find in backpack and equip
    local tool = backpack:FindFirstChild(toolName)
    if tool then
        LocalPlayer.Character.Humanoid:EquipTool(tool)
    end
end

local function startToolWatcher()
    task.spawn(function()
        while autoFarmEnabled do
            equipTool(selectedTool)
            task.wait(1)
        end
    end)
end

local function setNoclip(enabled)
    if enabled then
        noclipEnabled = true
        if noclipConnection then return end
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, child in pairs(char:GetDescendants()) do
                if child:IsA("BasePart") and child.CanCollide == true then
                    child.CanCollide = false
                end
            end
        end)
    else
        noclipEnabled = false
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function getBossSpawnId(npc)
    local ok, id = pcall(function() return npc:GetAttribute("SpawnId") end)
    return (ok and id) or nil
end

local function trackBossDeath(npc, npcName)
    local spawnId = getBossSpawnId(npc) or npcName

    if bossDeathConnections[spawnId] then
        pcall(function() bossDeathConnections[spawnId]:Disconnect() end)
        bossDeathConnections[spawnId] = nil
    end

    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local function onGone()
        print("[AutoFarm] Boss gone, clearing skip: " .. spawnId)
        thresholdSkipped[spawnId] = nil
        if bossDeathConnections[spawnId] then
            pcall(function() bossDeathConnections[spawnId]:Disconnect() end)
            bossDeathConnections[spawnId] = nil
        end
        if bossDeathConnections[spawnId .. "_ancestry"] then
            pcall(function() bossDeathConnections[spawnId .. "_ancestry"]:Disconnect() end)
            bossDeathConnections[spawnId .. "_ancestry"] = nil
        end
    end

    bossDeathConnections[spawnId] = humanoid.Died:Connect(onGone)
    bossDeathConnections[spawnId .. "_ancestry"] = npc.AncestryChanged:Connect(function()
        if not isNPCValid(npc) then onGone() end
    end)
end

-- ─────────────────────────────────────────────
-- Hover / Anti-Gravity
-- Keeps the player floating HOVER_HEIGHT above the target NPC.
-- Call startHover(npc) when beginning an attack, stopHover() when done.
-- ─────────────────────────────────────────────
local function stopHover()
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    if hoverConnection then
        hoverConnection:Disconnect()
        hoverConnection = nil
    end
    -- Clean up on CURRENT character, not just cached reference
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, obj in ipairs(hrp:GetChildren()) do
                if obj:IsA("BodyPosition") or obj:IsA("BodyVelocity") or obj:IsA("BodyForce") then
                    obj:Destroy()
                end
            end
        end
    end
    -- Also restore physics
    local char2 = LocalPlayer.Character
    if char2 then
        local hum = char2:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
    end
end

local function startHover(getNPCPos)
    stopHover()  -- clear any old connection

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Add a BodyPosition to lock us in place above the NPC
    local bp = Instance.new("BodyPosition")
    bp.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
    bp.D         = 500
    bp.P         = 50000
    bp.Parent    = hrp

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce  = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity  = Vector3.zero
    bv.Parent    = hrp

    hoverConnection = RunService.Heartbeat:Connect(function()
        local npcPos = getNPCPos()
        if not npcPos then return end
        local targetPos = Vector3.new(npcPos.X, npcPos.Y + HOVER_HEIGHT, npcPos.Z)
        bp.Position = targetPos
        bv.Velocity = Vector3.zero
    end)
end

local function fireTeleport(islandName)
