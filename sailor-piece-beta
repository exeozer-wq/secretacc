local function spawnBoss(cfg, difficulty)
    local strongestArg = STRONGEST_BOSS_ARGS[cfg.npcName]
    if strongestArg then
        pcall(function() RequestSpawnStrongestBoss:FireServer(strongestArg, difficulty) end)
        print(string.format("[BossSpawn] Fired RequestSpawnStrongestBoss for %s (%s) | difficulty: %s", cfg.display, strongestArg, difficulty))
        return
    end

    local dedicated = DEDICATED_SPAWN_REMOTES[cfg.npcName]
    if dedicated then
        pcall(function() dedicated:FireServer(difficulty) end)
        print(string.format("[BossSpawn] Fired dedicated remote for %s | difficulty: %s", cfg.display, difficulty))
        return
    end

    pcall(function() RequestSummonBoss:FireServer(cfg.npcName, difficulty) end)
    print(string.format("[BossSpawn] Fired RequestSummonBoss for %s | difficulty: %s", cfg.display, difficulty))
end

local function runAutoSpawn()
    print("[AutoSpawn] Started")
    local watchedBosses = {}  -- npcName -> true (currently being watched, don't re-trigger)

    local function watchAndRespawn(cfg)
        if watchedBosses[cfg.npcName] then return end

        -- Find the live NPC
        local ok, children = pcall(function() return workspace.NPCs:GetChildren() end)
        if not ok then return end

        local liveNPC = nil
        for _, child in ipairs(children) do
            local bossId = child:GetAttribute("BossId")
            if (bossId == cfg.npcName or child.Name:find("^" .. cfg.npcName)) and isNPCAlive(child) then
                liveNPC = child
                break
            end
        end
        if not liveNPC then return end

        local humanoid = liveNPC:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        watchedBosses[cfg.npcName] = true
        print(string.format("[AutoSpawn] Watching %s for death...", cfg.display))

        humanoid.Died:Connect(function()
            if not autoSpawnEnabled then
                watchedBosses[cfg.npcName] = nil
                return
            end
            print(string.format("[AutoSpawn] %s died — respawning in 3s...", cfg.display))
            task.wait(3)
            if not autoSpawnEnabled then
                watchedBosses[cfg.npcName] = nil
                return
            end
            -- Small offset per boss to avoid simultaneous remote spam
            local spawnOffset = 0
            for i, c in ipairs(selectedSpawnBosses) do
                if c.npcName == cfg.npcName then
                    spawnOffset = (i - 1) * 1.5  -- 1.5s gap between each boss
                    break
                end
            end
            if spawnOffset > 0 then
                task.wait(spawnOffset)
            end
            if not autoSpawnEnabled then watchedBosses[cfg.npcName] = nil; return end

            -- Spam remote until boss appears
            local deadline = tick() + 5
            repeat
                spawnBoss(cfg, selectedDifficulty)
                task.wait(0.3)
            until isBossAlive(cfg) or tick() > deadline or not autoSpawnEnabled
            watchedBosses[cfg.npcName] = nil  -- clear so we can re-watch the new instance
        end)
    end

    -- Initial spawn pass: if boss isn't alive yet, spawn it first
    for _, cfg in ipairs(selectedSpawnBosses) do
        if not isBossAlive(cfg) then
            print(string.format("[AutoSpawn] %s not alive — initial spawn...", cfg.display))
            local deadline = tick() + 5
            repeat
                spawnBoss(cfg, selectedDifficulty)
                task.wait(0.3)
            until isBossAlive(cfg) or tick() > deadline or not autoSpawnEnabled
        end
    end

    -- Main loop: just attaches death watchers, no polling spam
    while autoSpawnEnabled do
        for _, cfg in ipairs(selectedSpawnBosses) do
            if not autoSpawnEnabled then break end
            if isBossAlive(cfg) and not watchedBosses[cfg.npcName] then
                watchAndRespawn(cfg)
            end
        end
        task.wait(1)  -- light poll just to catch newly alive bosses and attach watchers
    end

    watchedBosses = {}
    print("[AutoSpawn] Stopped")
end

