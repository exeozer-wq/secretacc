    pcall(function() TeleportToPortal:FireServer(arg) end)
end

-- ─────────────────────────────────────────────
-- Teleport to island, fire checkpoint, wait to arrive
-- ─────────────────────────────────────────────
local function teleportToIsland(islandName)
    print("[Teleport] Firing portal to: " .. islandName)
    fireTeleport(islandName)
    
    -- Wait for the server to actually move us (position stops changing)
    task.wait(2) -- initial delay for server to process
    local root = getPlayerRoot()
    if root then
        local lastPos = root.Position
        local stableCount = 0
        for _ = 1, 30 do -- max ~3 more seconds
            task.wait(0.1)
            root = getPlayerRoot()
            if not root then break end
            local dist = (root.Position - lastPos).Magnitude
            if dist < 1 then
                stableCount += 1
                if stableCount >= 5 then break end -- stable for 0.5s = done
            else
                stableCount = 0
                lastPos = root.Position
            end
        end
    end
    
    currentTrackedIsland = islandName
    print("[Teleport] Tracked island set to: " .. islandName)
    return true
end

-- Teleport to island then tween to hover above the NPC
local function teleportAndHover(npc, islandName)
    local arrived = teleportToIsland(islandName)
    if not arrived then return false end

    -- Tween to a position above the NPC
    local npcPos = getNPCPosition(npc)
    if not npcPos then return false end

