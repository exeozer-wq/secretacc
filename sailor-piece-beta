Tab:CreateToggle({
    Name = "Auto Attack",
    CurrentValue = false,
    Flag = "AutoAttack",
    Callback = function(value)
        attackEnabled = value
        if attackEnabled then
            task.spawn(function()
                while attackEnabled do
                    local targets = getTargetNPCs()
                    if #targets == 0 then
                        task.wait(0.5)
                        continue
                    end

                    for _, npc in ipairs(targets) do
						if not attackEnabled then break end
						if not isNPCAlive(npc) then continue end

						local npcRoot = getNPCRoot(npc)
						if not npcRoot then continue end

						local character = LocalPlayer.Character
						if not character then continue end
						local playerRoot = character:FindFirstChild("HumanoidRootPart")
						if not playerRoot then continue end

						local dist = (playerRoot.Position - npcRoot.Position).Magnitude
						if dist > 200 then
							glideTowards(npcRoot.Position)
						end

						-- Keep attacking this NPC until it dies
						while attackEnabled and isNPCAlive(npc) do
							npcRoot = getNPCRoot(npc)
							if not npcRoot then break end

							local pos = npcRoot.Position
							RequestHit:FireServer(Vector3.new(pos.X, pos.Y, pos.Z))
							task.wait(0.35)
						end
					end
                end
            end)
        end
    end,
})

local Paragraph = Tab:CreateParagraph({Title = "Warning", Content = "won't work if  you're further than 200 studs away from target; auto attack automatically teleports you towards target in this case."})

Tab:CreateToggle({
    Name = "Auto Quest",
    CurrentValue = false,
    Flag = "AutoQuest",
    Callback = function(value)
        autoQuestEnabled = value
        if autoQuestEnabled then
            task.spawn(function()
                while autoQuestEnabled do
                    if not hasActiveQuest then
                        local level = LocalPlayer.Data and LocalPlayer.Data.Level and LocalPlayer.Data.Level.Value or 0
                        local npc = getQuestNPC(level)
                        QuestAccept:FireServer(npc)
                    end
                    task.wait(1)
                end
            end)
        end
    end,
})

