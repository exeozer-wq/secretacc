-- Cache crystal positions once at startup
local islandPositions = {}
for name, crystal in pairs(islandCrystals) do
    if crystal then
        local ok, pos = pcall(function() return crystal:GetPivot().Position end)
        if ok and pos then islandPositions[name] = pos end
    end
end

local function fireCheckpoint(islandName)
    local crystal = islandCrystals[islandName]
    if not crystal then
        warn("[CHITO] No crystal found for: " .. tostring(islandName))
        return
    end
    pcall(function()
        for _, child in ipairs(crystal:GetDescendants()) do
            if child.Name == "CheckpointPrompt" and child:IsA("ProximityPrompt") then
                fireproximityprompt(child)
                print("[CHITO] Checkpoint fired on: " .. islandName)
                return
            end
        end
        warn("[CHITO] CheckpointPrompt ProximityPrompt not found in: " .. islandName)
    end)
end

-- Returns the closest island key to a position (within 600 studs), or nil
local function getIslandForPosition(pos)
    local closest, closestDist = nil, math.huge
    for name, islandPos in pairs(islandPositions) do
        local d = (pos - islandPos).Magnitude
        if d < closestDist then
            closestDist = d
            closest = name
        end
    end
    return (closestDist <= 600) and closest or nil
end

