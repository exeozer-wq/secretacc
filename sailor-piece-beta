local function isBossAlive(cfg)
    local ok, children = pcall(function() return workspace.NPCs:GetChildren() end)
    if not ok then return false end
    for _, child in ipairs(children) do
        local bossId = child:GetAttribute("BossId")
        if (bossId == cfg.npcName or child.Name:find("^" .. cfg.npcName)) and isNPCAlive(child) then
            return true
