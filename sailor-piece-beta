-- Merchant Helpers
-- ─────────────────────────────────────────────
local function getPlayerMoney()
    local ok, val = pcall(function() return LocalPlayer.Data.Money.Value end)
    return (ok and type(val) == "number") and val or 0
end

local function getPlayerGems()
    local ok, val = pcall(function() return LocalPlayer.Data.Gems.Value end)
    return (ok and type(val) == "number") and val or 0
end

local function fetchStock()
    local ok, result = pcall(function() return GetMerchantStock:InvokeServer() end)
    if ok and type(result) == "table" and type(result.stock) == "table" then
        merchantStock = result.stock
        return true
    end
    return false
end

local function getStockDropdownOptions()
    local opts = {}
    for itemName in pairs(merchantStock) do
        table.insert(opts, itemName)
    end
    table.sort(opts)
    return opts
end

local function tryBuyItem(itemName, itemData)
    local currency  = itemData.currency or "Gems"
    local price     = itemData.price    or 0
    local stock     = itemData.stock    or 0

    if stock <= 0 or price <= 0 then return end

    local balance   = (currency == "Gems") and getPlayerGems() or getPlayerMoney()
    local threshold = (currency == "Gems") and gemThreshold    or moneyThreshold

    local spendable = balance - threshold
    if spendable <= 0 then
        print(string.format("[Merchant] %s below threshold — skipping %s (have %.0f, threshold %.0f)",
            currency, itemName, balance, threshold))
        return
    end

    local canAfford = math.floor(spendable / price)
    local toBuy     = math.min(canAfford, stock)

    if toBuy <= 0 then
        print(string.format("[Merchant] Can't afford %s (price %.0f %s, spendable %.0f)",
            itemName, price, currency, spendable))
        return
    end

    print(string.format("[Merchant] Buying %dx %s (%.0f %s each)", toBuy, itemName, price, currency))
    for i = 1, toBuy do
        if not autoMerchantEnabled then break end
        pcall(function() PurchaseMerchant:InvokeServer(itemName, 1) end)
        task.wait(0.4)
    end
end

local MERCHANT_REFRESH_INTERVAL = 31 * 60  -- 31 minutes in seconds

local function runAutoMerchant()
    local lastItemSnapshot = {}

    local function itemsChanged()
		for _, v in ipairs(selectedMerchantItems) do
			if not table.find(lastItemSnapshot, v) then return true end
		end
		return false
	end

    local function snapshotItems()
        lastItemSnapshot = {}
        for _, v in ipairs(selectedMerchantItems) do
            table.insert(lastItemSnapshot, v)
        end
    end

    local function doBuyCycle()
        print("[Merchant] Fetching stock...")
        local ok = fetchStock()
        if ok then
            WindUI:Notify({ Title = "Merchant", Content = "Buying selected items...", Icon = "check", Duration = 3 })
            for _, itemName in ipairs(selectedMerchantItems) do
                if not autoMerchantEnabled then break end
                local itemData = merchantStock[itemName]
                if itemData then
                    tryBuyItem(itemName, itemData)
                end
                task.wait(0.3)
            end
        else
            print("[Merchant] Failed to fetch stock.")
            WindUI:Notify({ Title = "Merchant", Content = "Stock fetch failed, retrying next cycle.", Icon = "x", Duration = 3 })
        end
        snapshotItems()
    end

    -- Initial buy on enable
    doBuyCycle()

    local waited = 0
    while autoMerchantEnabled do
        task.wait(1)
        waited += 1

        -- New item added mid-wait? Buy immediately (reuse cached stock, re-fetch to be safe)
        if itemsChanged() then
            print("[Merchant] Item selection changed, triggering buy cycle...")
            WindUI:Notify({ Title = "Merchant", Content = "New item detected, buying now...", Icon = "shopping-cart", Duration = 3 })
            doBuyCycle()
            waited = 0  -- reset the 31-min timer after a triggered cycle
        end

        if waited % 300 == 0 and waited > 0 then
            local remaining = math.floor((MERCHANT_REFRESH_INTERVAL - waited) / 60)
            print(string.format("[Merchant] Next refresh in %d min...", remaining))
        end

        if waited >= MERCHANT_REFRESH_INTERVAL then
            print("[Merchant] 31 minutes elapsed, refreshing stock...")
            doBuyCycle()
            waited = 0
        end
    end

    print("[Merchant] Auto Buy stopped.")
end

