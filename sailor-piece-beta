Tab:CreateToggle({
    Name = "Auto Attack",
    CurrentValue = false,
    Flag = "AutoAttack",
    Callback = function(value)
        attackEnabled = value
        if not attackEnabled then return end

        task.spawn(function()
            while attackEnabled do
                local targets = getTargetNPCs()
                if #targets == 0 then task.wait(0.5) continue end

                for _, npc in ipairs(targets) do
                    if not attackEnabled then break end
                    if not isNPCValid(npc) then continue end
                    if not isNPCAlive(npc) then continue end

                    -- ── GATE 1: Try to get NPC position ──────────────────────────────
                    -- If nil, the NPC's parts aren't loaded on this island.
                    -- DO NOT touch it — wait for teleport instead.
                    local npcPos = getNPCPosition(npc)

                    local root = getPlayerRoot()
                    if not root then continue end

                    -- ── GATE 2: Distance check ────────────────────────────────────────
                    -- If we can't read the position OR it's > 400 studs → teleport flow
                    local dist = npcPos and (root.Position - npcPos).Magnitude or math.huge

                    if dist > 400 then
                        -- npcPos may be nil if NPC parts aren't loaded on this island.
                        -- In that case, figure out the target island from the group name
                        -- using the pre-cached crystal positions — no live NPC reads needed.
                        local posForIsland = npcPos

                        if not posForIsland then
                            -- Find which island this group belongs to by checking
                            -- which island crystal is closest to the NPC's expected island.
                            -- We do this by matching the NPC name to a known island key.
                            local npcName = npc.Name:lower()
                            local bestIsland = nil

                            -- Direct name-to-island hints based on NPC naming convention
                            local nameHints = {
                                academy    = "Academy",
                                arena      = "Lawless",
                                curse      = "Shinjuku",
                                desert     = "Desert",
                                frost      = "Snow",
                                hollow     = "Hollow",
                                monkey     = "Jungle",
                                ninja      = "Ninja",
                                quincy     = "Soul",
                                slime      = "Slime",
                                sorcerer   = "Shibuya",
                                strong     = "Shinjuku",
                                swordsman  = "Judgement",
                                thief      = "Starter",
                                training   = "Starter",
                                gojo       = "Shibuya",
                                panda      = "Shibuya",
                                yamato     = "Soul",
                                sukuna     = "Soul",
                                aizen      = "Tower",
                                yuji       = "Tower",
                                snow       = "Snow",
                                strongest  = "Ninja",
                                monkey     = "Jungle",
                            }

                            for hint, island in pairs(nameHints) do
                                if npcName:find(hint) then
                                    bestIsland = island
                                    break
                                end
                            end

                            if bestIsland and islandPositions[bestIsland] then
                                posForIsland = islandPositions[bestIsland]
                            else
                                -- Can't determine island at all, skip
                                print("[CHITO] Cannot determine island for: " .. tostring(npc.Name) .. " — skipping")
                                task.wait(0.5)
                                continue
                            end
                        end

                        local ready = teleportAndApproach(npc, posForIsland)
                        if not ready then task.wait(1) continue end
                    end

                    -- ── ATTACK LOOP ───────────────────────────────────────────────────
					while attackEnabled and isNPCValid(npc) and isNPCAlive(npc) do
						local root = getPlayerRoot()

						-- Death recovery mid-combat
						if not root then
							print("[CHITO] Died mid-combat, waiting for respawn...")
							task.wait(1)
							local respawnDeadline = tick() + 6
							while tick() < respawnDeadline do
								root = getPlayerRoot()
								if root then
									print("[CHITO] Respawned, re-approaching...")
									break
								end
								task.wait(0.5)
							end
							if not root then break end
							-- After respawn, tween back toward NPC
							local pos = getNPCPosition(npc)
							if not pos then break end
							tweenTowards(pos)
							continue
						end

						local pos = getNPCPosition(npc)
						if not pos then task.wait(0.5) break end

						local d = (root.Position - pos).Magnitude
						if d > 250 then
							tweenTowards(pos)
							continue
						end

						pcall(function()
							RequestHit:FireServer(Vector3.new(pos.X, pos.Y, pos.Z))
						end)
						task.wait(0.35)
					end
                end
            end
        end)
    end,
})

