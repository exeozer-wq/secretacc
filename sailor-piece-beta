-- ─────────────────────────────────────────────
-- Safe Helpers — every NPC/instance access in pcall
-- ─────────────────────────────────────────────

local function isNPCValid(npc)
    if not npc then return false end
    local ok, res = pcall(function() return npc.Parent ~= nil end)
    return ok and res == true
end

local function isNPCAlive(npc)
    if not isNPCValid(npc) then return false end
    local ok, res = pcall(function()
        local h = npc:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0
    end)
    return ok and res == true
end

-- Returns the NPC's world position, or nil if the NPC is not loaded/reachable
local function getNPCPosition(npc)
    if not isNPCValid(npc) then return nil end
    local ok, res = pcall(function()
        local root = npc:FindFirstChild("HumanoidRootPart")
            or npc:FindFirstChild("PrimaryPart")
            or npc:FindFirstChildWhichIsA("BasePart")
        if not root then return nil end
        return root.Position
    end)
    return (ok and res) or nil
end

local function getPlayerRoot()
    local ok, res = pcall(function()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end)
    return (ok and res) or nil
end

local function getTargetNPCs()
    local targets = {}
    for _, groupName in ipairs(selectedGroups) do
        local members = groups[groupName]
        if members then
            for _, npcName in ipairs(members) do
                local ok, npc = pcall(function()
                    return workspace.NPCs:FindFirstChild(npcName)
                end)
                if ok and npc and isNPCAlive(npc) then
                    table.insert(targets, npc)
                end
            end
        end
    end
    return targets
end

-- ─────────────────────────────────────────────
-- Tween towards a world position.
-- Does NOT call Completed:Wait() — waits fixed duration instead.
-- ─────────────────────────────────────────────
local TWEEN_DURATION = 0.15

local function tweenTowards(targetPos)
    local root = getPlayerRoot()
    if not root then return end

    local ok, dir = pcall(function() return targetPos - root.Position end)
    if not ok or dir.Magnitude < 1 then return end

    -- Stop 100 studs short so we don't overshoot into the NPC
    local dest = targetPos - dir.Unit * 100

    pcall(function()
        TweenService:Create(
            root,
            TweenInfo.new(TWEEN_DURATION, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(dest, targetPos) }
        ):Play()
    end)

    task.wait(TWEEN_DURATION) -- fixed yield, never hangs
end

-- ─────────────────────────────────────────────
-- Teleport to the NPC's island, verify arrival,
-- then tween close. Returns true if ready to attack.
-- Only called when NPC is > 400 studs away.
-- ─────────────────────────────────────────────
local function teleportAndApproach(npc, npcPos)
    local targetIsland = getIslandForPosition(npcPos)
    if not targetIsland then
        warn("[CHITO] Cannot determine island for NPC: " .. tostring(npc.Name))
        return false
    end

    local portalName = islandPortalNames[targetIsland]
    if not portalName then
        warn("[CHITO] No portal name for island: " .. targetIsland)
        return false
    end

    print("[CHITO] Teleporting to " .. portalName)
    pcall(function() TeleportToPortal:FireServer(portalName) end)

    task.wait(3)

    -- Fire checkpoint so death respawns us nearby
    fireCheckpoint(targetIsland)
    print("[CHITO] Checkpoint set on: " .. targetIsland)

    task.wait(0.5) -- small buffer after checkpoint fire

    -- Verify arrival
    local arrived = false
    local deadline = tick() + 5
    while tick() < deadline do
        local root = getPlayerRoot()
        if root then
            local ok, island = pcall(getIslandForPosition, root.Position)
            if ok and island == targetIsland then
                arrived = true
                break
            end
        end
        task.wait(0.5)
    end

    if not arrived then
        warn("[CHITO] Failed to verify arrival on: " .. portalName)
        return false
    end

    print("[CHITO] Arrived. Tweening to NPC...")

    -- Tween approach with death recovery:
    -- If character dies mid-tween, wait for respawn then continue
    local approachDeadline = tick() + 15 -- slightly longer to account for respawn
    while attackEnabled and isNPCAlive(npc) and tick() < approachDeadline do
        local root = getPlayerRoot()

        -- Death recovery: root nil means we're respawning
        if not root then
            print("[CHITO] Character dead, waiting for respawn...")
            task.wait(1)

            -- Wait up to 6s for character to respawn at checkpoint
            local respawnDeadline = tick() + 6
            while tick() < respawnDeadline do
                root = getPlayerRoot()
                if root then
                    print("[CHITO] Respawned, resuming tween...")
                    break
                end
                task.wait(0.5)
            end

            if not root then
                warn("[CHITO] Respawn timed out, aborting approach")
                return false
            end
        end

        local pos = getNPCPosition(npc)
        if not pos then return false end

        if (root.Position - pos).Magnitude <= 150 then break end

        tweenTowards(pos)
    end

    return attackEnabled and isNPCAlive(npc)
end

