local function getNPCRoot(npc)
    return npc:FindFirstChild("HumanoidRootPart")
        or npc:FindFirstChild("PrimaryPart")
        or npc:FindFirstChildWhichIsA("BasePart")
end

local function isNPCAlive(npc)
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function getTargetNPCs()
    local targets = {}
    for _, groupName in ipairs(selectedGroups) do
        local members = groups[groupName]
        if members then
            for _, npcName in ipairs(members) do
                local npc = workspace.NPCs:FindFirstChild(npcName)
                if npc and isNPCAlive(npc) then
                    table.insert(targets, npc)
                end
            end
        end
    end
    return targets
end

local function glideTowards(targetPos)
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    while attackEnabled do
        local dist = (root.Position - targetPos).Magnitude
        if dist <= 200 then break end
        local direction = (targetPos - root.Position).Unit
        local step = root.Position + direction * 3
        root.CFrame = CFrame.new(step, step + direction)
        task.wait(0.03)
    end
end

local function getQuestNPC(level)
    if level <= 99 then return "QuestNPC1"
    elseif level <= 249 then return "QuestNPC2"
    elseif level <= 499 then return "QuestNPC3"
    elseif level <= 749 then return "QuestNPC4"
    elseif level <= 999 then return "QuestNPC5"
    elseif level <= 1499 then return "QuestNPC6"
    elseif level <= 1999 then return "QuestNPC7"
    elseif level <= 2999 then return "QuestNPC8"
    elseif level <= 3999 then return "QuestNPC9"
    elseif level <= 5000 then return "QuestNPC10"
    elseif level <= 6250 then return "QuestNPC11"
    elseif level <= 7000 then return "QuestNPC12"
    elseif level <= 7999 then return "QuestNPC13"
    elseif level <= 9000 then return "QuestNPC14"
    elseif level <= 10000 then return "QuestNPC15"
    elseif level <= 10750 then return "QuestNPC16"
    elseif level <= 11500 then return "QuestNPC17"
    elseif level <= 12000 then return "QuestNPC18"
    else return "QuestNPC19"
    end
end

