-- Attack loop  (fires hits while hovering above NPC)
-- ─────────────────────────────────────────────
local function runAttackLoop(npc, session, isBoss, npcName)
    local spawnId = getBossSpawnId(npc) or npcName

    if isBoss and bossHPThreshold < 100 then
        -- Check here instead of before teleport — we now know this is the
        -- live instance we actually traveled to, not a stale string match
        if thresholdSkipped[spawnId] then
            print("[Threshold] Skipping already-damaged instance: " .. spawnId)
            stopHover()
            return
        end
        myDamageThisEngagement = 0
        trackingDamage = true
        local maxHP = (npc:FindFirstChildOfClass("Humanoid") and npc:FindFirstChildOfClass("Humanoid").MaxHealth) or math.huge
        local damageGoal = maxHP * (bossHPThreshold / 100)
        print(string.format("[Threshold] Goal: %.0f damage (%.0f%% of %.0f HP)", damageGoal, bossHPThreshold, maxHP))

        while autoFarmEnabled and farmSession == session and isNPCValid(npc) and isNPCAlive(npc) do
            if myDamageThisEngagement >= damageGoal then
                print(string.format("[Threshold] My damage: %.0f / %.0f — stopping.", myDamageThisEngagement, damageGoal))
                thresholdSkipped[spawnId] = true
                break
            end
            local pos = getNPCPosition(npc)
            if not pos then task.wait(0.5); break end
            fireHit(pos)
            task.wait(0.35)
        end

        trackingDamage = false
    else
        while autoFarmEnabled and farmSession == session and isNPCValid(npc) and isNPCAlive(npc) do
            local pos = getNPCPosition(npc)
            if not pos then task.wait(0.5); break end
            fireHit(pos)
            task.wait(0.35)
        end
    end

    stopHover()
end

