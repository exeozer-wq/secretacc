local function runPityFarm(session)
    print("[PityFarm] Started | session=" .. session)
    local capturedFarmSession = farmSession

    -- Inner teleport (reuses existing doTeleport pattern)
    local function doTeleport(islandName)
        print("[PityFarm] Teleporting to: " .. islandName)
        for _ = 1, 6 do
            fireTeleport(islandName)
            task.wait(0.4)
        end
        currentTrackedIsland = islandName
        local root = getPlayerRoot()
        if root then
            local lastPos = root.Position
            local stable  = 0
            for _ = 1, 30 do
                task.wait(0.1)
                root = getPlayerRoot()
                if not root then break end
                if (root.Position - lastPos).Magnitude < 1 then
                    stable += 1
                    if stable >= 5 then break end
                else
                    stable = 0
                    lastPos = root.Position
                end
            end
        end
        task.wait(0.5)
    end

    local function tweenToHoverPity(targetPos, heightOffset, speed)
        local root = getPlayerRoot()
        if not root then return false end
        heightOffset = heightOffset or 70
        speed        = speed        or 120
        local dest   = Vector3.new(targetPos.X, targetPos.Y + heightOffset, targetPos.Z)
        local dist   = (root.Position - dest).Magnitude
        local dur    = math.max(dist / speed, 0.3)
        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
        activeTween = TweenService:Create(root,
            TweenInfo.new(dur, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(dest) }
        )
        pcall(function() activeTween:Play() end)
        task.wait(dur)
        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
        return true
    end

    while pityFarmEnabled and pityFarmSession == session do

        -- Always re-read pity from GUI
        local text   = getPityText()
        local parsed = parsePity(text)
        if parsed ~= nil then currentPity = parsed end

        local cfg = selectedPityBoss and BOSS_MAP[selectedPityBoss]
        if not cfg then
            task.wait(1)
            continue
        end

        -- ── At 24/25: pity-only mode ──────────────────────────────────
        if currentPity ~= nil and currentPity >= 24 then

            local pityNPC = findLivePityBoss()

            if pityNPC then
                -- Pity boss is alive — go kill it (this is the guaranteed drop kill)
                pityBossWatching = false
                print("[PityFarm] 24/25 — attacking pity boss: " .. cfg.display)

                if currentTrackedIsland ~= cfg.island then
                    doTeleport(cfg.island)
                    if not (pityFarmEnabled and pityFarmSession == session) then break end
                end

                local npcPos = getNPCPosition(pityNPC)
                if npcPos then
                    tweenToHoverPity(npcPos, 70, 120)
                    if not (pityFarmEnabled and pityFarmSession == session) then stopHover(); break end
                    startHover(function() return getNPCPosition(pityNPC) end)
                    task.wait(0.5)
                    if not (pityFarmEnabled and pityFarmSession == session) then stopHover(); break end

                    -- At 24/25 we ALWAYS fully kill — ignore bossHPThreshold for pity kill
                    local savedThreshold = bossHPThreshold
                    bossHPThreshold = 100
                    runAttackLoop(pityNPC, capturedFarmSession, true, cfg.npcName)
                    bossHPThreshold = savedThreshold

                    stopHover()
                    task.wait(0.5)

                    -- Re-read pity after kill
                    task.wait(1.5)  -- small wait for server to update GUI
                    local newText = getPityText()
                    local newPity = parsePity(newText)
                    if newPity ~= nil then currentPity = newPity end
                    print("[PityFarm] Pity after kill: " .. tostring(currentPity))
                end

            else
                -- Pity boss is dead / not spawned yet — farm mobs, watch for it
                if not pityBossWatching then
                    pityBossWatching = true
                    WindUI:Notify({
                        Title    = "Pity Farm",
                        Content  = "24/25 — waiting for " .. cfg.display .. " to spawn. Farming mobs.",
                        Icon     = "clock",
                        Duration = 6,
                    })
                end

                -- Farm one mob cycle then loop back
                if selectedMobGroup then
                    local npcNames = groups[selectedMobGroup]
                    if npcNames then
                        for _, npcName in ipairs(npcNames) do
                            if not (pityFarmEnabled and pityFarmSession == session) then break end
                            local mobNPC = findLiveNPC(npcName)
                            if mobNPC then
                                local mobPos = getNPCPosition(mobNPC)
                                if mobPos then
                                    tweenToHoverPity(mobPos, 70, 120)
                                    mobNPC = waitForNPC(npcName, 2)
                                    if mobNPC then
                                        local finalPos = getNPCPosition(mobNPC)
                                        if finalPos then
                                            startHover(function() return getNPCPosition(mobNPC) end)
                                            task.wait(0.3)
                                            runAttackLoop(mobNPC, capturedFarmSession, false, npcName)
                                            stopHover()
                                        end
                                    end
                                end
                                break  -- one mob per cycle so we can re-check pity boss quickly
                            end
                        end
                    end
                end

                task.wait(0.5)
            end

        -- ── Below 24/25: normal farm (all selected bosses + pity boss included) ──
        else
            pityBossWatching = false

            -- Check all selected bosses (same logic as runAutoFarm's boss block)
            -- but ALSO include the pity boss even if not in selectedBossKeys
            local bossKeysToCheck = {}
            for _, k in ipairs(selectedBossKeys) do table.insert(bossKeysToCheck, k) end

            -- Add pity boss if not already in the list
            if selectedPityBoss and not table.find(bossKeysToCheck, selectedPityBoss) then
                table.insert(bossKeysToCheck, selectedPityBoss)
            end

            local liveBoss    = nil
            local liveBossCfg = nil

            for _, bossKey in ipairs(bossKeysToCheck) do
                if not (pityFarmEnabled and pityFarmSession == session) then break end
                local bossCfg = BOSS_MAP[bossKey]
                if not bossCfg then continue end

                local ok, children = pcall(function() return workspace.NPCs:GetChildren() end)
                if not ok then continue end
                local found = nil
                for _, child in ipairs(children) do
                    if child:GetAttribute("BossId") == bossCfg.npcName and isNPCAlive(child) then
                        found = child; break
                    end
                end
                if not found then continue end

                if currentTrackedIsland ~= bossCfg.island then
                    doTeleport(bossCfg.island)
                    if not (pityFarmEnabled and pityFarmSession == session) then break end
                end

                local npc = waitForNPC(bossCfg.npcName, 2)
                if npc then
                    liveBoss    = npc
                    liveBossCfg = bossCfg
                    break
                end
            end

            if liveBoss and liveBossCfg then
                local npcPos = getNPCPosition(liveBoss)
                if npcPos then
                    tweenToHoverPity(npcPos, 70, 120)
                    if not (pityFarmEnabled and pityFarmSession == session) then stopHover(); continue end
                    startHover(function() return getNPCPosition(liveBoss) end)
                    task.wait(0.5)
                    if not (pityFarmEnabled and pityFarmSession == session) then stopHover(); continue end
                    runAttackLoop(liveBoss, capturedFarmSession, true, liveBossCfg.npcName)
                    stopHover()
                    task.wait(0.3)

                    -- Re-read pity after every kill
                    task.wait(1.5)
                    local newText = getPityText()
                    local newPity = parsePity(newText)
                    if newPity ~= nil then currentPity = newPity end
                    print("[PityFarm] Pity after kill: " .. tostring(currentPity))
                end
            elseif selectedMobGroup then
                -- No boss found, farm a mob
                local npcNames = groups[selectedMobGroup]
                if npcNames then
                    for _, npcName in ipairs(npcNames) do
                        if not (pityFarmEnabled and pityFarmSession == session) then break end
                        local mobNPC = findLiveNPC(npcName)
                        if mobNPC then
                            local mobPos = getNPCPosition(mobNPC)
                            if mobPos then
                                tweenToHoverPity(mobPos, 70, 120)
                                mobNPC = waitForNPC(npcName, 2)
                                if mobNPC then
                                    local finalPos = getNPCPosition(mobNPC)
                                    if finalPos then
                                        startHover(function() return getNPCPosition(mobNPC) end)
                                        task.wait(0.3)
                                        runAttackLoop(mobNPC, capturedFarmSession, false, npcName)
                                        stopHover()
                                    end
                                end
                            end
                            break
                        end
                    end
                end
            else
                task.wait(0.7)
            end
        end

        if pityFarmEnabled and pityFarmSession == session then
            task.wait(0.5)
        end
    end

    pityBossWatching = false
    stopHover()
    print("[PityFarm] Stopped | session=" .. session)
end


