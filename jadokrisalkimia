            Value = DefaultValue,
            Callback = function(value)
                ConfigName = value
                ConfigNameInput:Set(value)
            end
        })

        ConfigTab:Space()

        local autoLoadNames = ConfigManager:AllConfigs()
        table.insert(autoLoadNames, 1, "None")

        local AutoLoadDropdown = ConfigTab:Dropdown({
            Title = "Auto Load Config",
            Desc = "This config will load automatically on next script start.",
            Values = autoLoadNames,
            Value = getAutoLoadPref() or "None",
            Callback = function(value)
                setAutoLoadPref(value)
                WindUI:Notify({
                    Title = value == "None" and "Auto Load Cleared" or "Auto Load Set",
                    Content = value == "None" and "No config will auto-load" or "'" .. value .. "' loads on next start",
                    Duration = 4
                })
            end
        })

        ConfigTab:Space()

        ConfigTab:Button({
            Title = "Save Config",
            Icon = "",
            Justify = "Center",
            Callback = function()
                Window.CurrentConfig = ConfigManager:Config(ConfigName)
                if Window.CurrentConfig:Save() then
                    WindUI:Notify({
                        Title = "Config Saved",
                        Content = "Config '" .. ConfigName .. "' saved",
                        Icon = "check",
                    })
                end
                local fresh = ConfigManager:AllConfigs()
                AllConfigsDropdown:Refresh(fresh)

                local freshWithNone = {"None"}
                for _, v in ipairs(fresh) do table.insert(freshWithNone, v) end
                AutoLoadDropdown:Refresh(freshWithNone)
            end
        })

        ConfigTab:Space()

        ConfigTab:Button({
            Title = "Load Config",
            Icon = "",
            Justify = "Center",
            Callback = function()
                Window.CurrentConfig = ConfigManager:Config(ConfigName)  -- Config not CreateConfig
                if Window.CurrentConfig:Load() then
                    WindUI:Notify({
                        Title = "Config Loaded",
                        Content = "Config '" .. ConfigName .. "' loaded",
                        Icon = "refresh-cw",
                    })
                end
            end
        })
    end
end




