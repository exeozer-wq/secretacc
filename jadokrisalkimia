        if not isTargetAlive(currentFarmTarget) then
            currentFarmTarget = getAliveMob()
            if not currentFarmTarget then return end
            equipWand()
        end

        local mobHRP = currentFarmTarget:FindFirstChild("HumanoidRootPart") or currentFarmTarget.PrimaryPart
        if not mobHRP then
            currentFarmTarget = nil
            return
        end

        hrp.CFrame = mobHRP.CFrame * CFrame.new(0, 30, 0)

		local now = tick()
		if now - lastFarmAtk >= 0.1 then
			lastFarmAtk = now
			pcall(farmFireRemote, currentFarmTarget)
		end
    end)
end

local function stopAutoFarm()
    if autoFarmConnection then
        autoFarmConnection:Disconnect()
        autoFarmConnection = nil
    end
    currentFarmTarget = nil
end

