-- Monitor quest name changes
local questConnections = {}

local function setupQuestMonitor()
    -- clear old connections
    for _, conn in ipairs(questConnections) do conn:Disconnect() end
    table.clear(questConnections)

    local Task = LocalPlayer:WaitForChild("Task")

	-- Check already-completed quests on startup
    task.spawn(function()
        task.wait(1)
        if not autoClaimEnabled then return end
        for questName, data in pairs(questData) do
            if table.find(selectedQuests, questName) then
                if Task:FindFirstChild(data.completedName) then
                    print("Found already-completed quest on startup:", questName)
                    task.wait(1)
                    claimQuest()
                end
            end
        end
    end)

    -- Watch for any child name change (active -> completed)
	table.insert(questConnections, Task.ChildAdded:Connect(function(child)
		task.wait(0.2)
		for questName, data in pairs(questData) do
			if table.find(selectedQuests, questName) then
				if child.Name == data.completedName and autoClaimEnabled then
					task.wait(1)
					claimQuest()
				end
			end
		end
	end))

    -- Watch for child removed (claimed) -> retake
    table.insert(questConnections, Task.ChildRemoved:Connect(function(child)
        task.wait(1)
        if not autoRetakeEnabled then return end
        for questName, data in pairs(questData) do
            if table.find(selectedQuests, questName) then
                if child.Name == data.completedName or child.Name == data.activeName then
                    -- only retake if quest is no longer active
                    task.wait(0.5)
                    if not hasQuestActive(data) then
                        takeQuest(data)
                    end
                end
            end
        end
    end))
end

