local function kaClearTarget()
    if kaHighlight then kaHighlight:Destroy() kaHighlight = nil end
    kaTarget = nil
end

local function kaApplyHighlight(mob)
    if kaHighlight then kaHighlight:Destroy() end
    kaHighlight = Instance.new("SelectionBox")
    kaHighlight.Adornee = mob
    kaHighlight.Color3 = Color3.fromRGB(255, 50, 50)
    kaHighlight.LineThickness = 0.05
    kaHighlight.SurfaceTransparency = 0.6
    kaHighlight.SurfaceColor3 = Color3.fromRGB(255, 50, 50)
    kaHighlight.Parent = mob
end

local function kaGetClosest()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, closestDist = nil, math.huge
    for _, mob in ipairs(Monster:GetChildren()) do
        local mobHRP = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local torso = mob:FindFirstChild("Torso")
        if mobHRP and humanoid and humanoid.Health > 0 and torso then
            local dist = (hrp.Position - mobHRP.Position).Magnitude
            if dist <= kaRange and dist < closestDist then
                closestDist = dist
                closest = mob
            end
        end
    end
    return closest
end

