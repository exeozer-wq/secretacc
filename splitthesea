local function enableHook()
    if OldNamecall then return end   -- already hooked

    OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if getnamecallmethod() ~= "FireServer" then
            return OldNamecall(self, ...)
        end

        -- Most reliable ways to detect the correct remote (pick one or combine)
        if self == SplitRequest or self.Name == "SplitRequest" then
            local args = {...}
            if type(args[1]) == "number" then
                args[1] = 1
            end
            return OldNamecall(self, unpack(args))
        end

        return OldNamecall(self, ...)
    end)
end

local function disableHook()
    if not OldNamecall then return end
    hookmetamethod(game, "__namecall", OldNamecall)
    OldNamecall = nil
end




local function StartAutoLoot()
    if AutoLootThread then return end
    AutoLootEnabled = true
    AutoLootThread = task.spawn(function()
        while AutoLootEnabled do
            local Character = LocalPlayer.Character
            if not (Character and Character:FindFirstChild("HumanoidRootPart")) then
                task.wait(0.5)
                continue
            end
            local HRP = Character.HumanoidRootPart
            local toFire = {}
            for _, LootModel in ipairs(ActiveLoot:GetChildren()) do
                if LootModel:GetAttribute("OwnerUserId") == LocalPlayer.UserId
                and not ProcessedModels[LootModel] then
                    for _, desc in ipairs(LootModel:GetDescendants()) do
                        if desc:IsA("TouchInterest") or desc.ClassName == "TouchTransmitter" or desc.Name == "TouchInterest" then
                            local touchPart = desc.Parent
                            if touchPart and touchPart.Parent and touchPart:IsA("BasePart") then
                                table.insert(toFire, {model = LootModel, part = touchPart})
                            end
                        end
                    end
                end
            end
            if #toFire > 0 then
                print("[AutoLoot] Found " .. #toFire .. " touch parts — firing all now!")
                for _, entry in ipairs(toFire) do
                    local touchPart = entry.part
                    local model = entry.model
                    if touchPart and touchPart.Parent then
                        pcall(function()
                            firetouchinterest(HRP, touchPart, 0)
                            firetouchinterest(HRP, touchPart, 1)
                            firetouchinterest(touchPart, HRP, 0)  -- merged both pcalls, no waits
                            firetouchinterest(touchPart, HRP, 1)
                        end)
                    end
                    ProcessedModels[model] = true
                end
                task.wait(0.1)  -- reduced from 0.3
            end
            task.wait(0.15)  -- reduced from 0.4
        end
    end)
end


local function StopAutoLoot()
	AutoLootEnabled = false
	if AutoLootThread then
		task.cancel(AutoLootThread)
		AutoLootThread = nil
	end
end


-- Helper: checks if player still has loot to pick
local function hasOwnLoot()
	for _, model in ipairs(ActiveLoot:GetChildren()) do
		if model:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
			return true
		end
	end
	return false
end

-- Helper: finds the correct Split part no matter which island (Basic, CyberTech, etc.)
local function getPlayerSplit()
	local plotName = LocalPlayer:GetAttribute("PlotName")
	if not plotName then
		warn("[AutoFarm] Missing PlotName attribute!")
		return nil
	end

	for _, island in ipairs(workspace.Islands:GetChildren()) do
		local plots = island:FindFirstChild("Plots")
		if plots then
			local plot = plots:FindFirstChild(plotName)
			if plot then
				local important = plot:FindFirstChild("Important")
				if important then
					local partt = important:FindFirstChild("Partt")
					if partt then
						local split = partt:FindFirstChild("Split")
						if split and split:IsA("BasePart") then
							return split
						end
					end
				end
			end
		end
	end

	warn("[AutoFarm] Could not find Split for plot:", plotName)
	return nil
end

local function StartAutoFarm()
    if FarmThread then return end

    AutoFarmEnabled = true
    FarmThread = task.spawn(function()
        while AutoFarmEnabled do
            local splitPart = getPlayerSplit()
            if not splitPart then task.wait(1) continue end

            local Character = LocalPlayer.Character
            local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
            if not HRP then task.wait(0.5) continue end

            -- === 1. Teleport to Split & fire request ===
            HRP.CFrame = splitPart.CFrame + Vector3.new(0, 5, 0)
            HRP.AssemblyLinearVelocity = Vector3.zero   -- kill momentum
            HRP.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.8)

            pcall(function()
                game:GetService("ReplicatedStorage").Remotes.SplitRequest:FireServer(1, true)
            end)
            task.wait()

            -- === 2. Begin looting ===
            StartAutoLoot()

            local cycleStart = os.clock()

            -- === 3. Forward jumps with hover spam ===
            local firstJump = true  -- track first jump
            while AutoFarmEnabled and hasOwnLoot() and (os.clock() - cycleStart < MaxCycleTime) do
                Character = LocalPlayer.Character
                HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                if not HRP then task.wait(0.1) continue end

                local forward = HRP.CFrame.LookVector * 200
                local heightOffset = firstJump and 20 or 0  -- 20 on first, 0 after
                local newPos  = HRP.Position + forward + Vector3.new(0, heightOffset, 0)
                local newCF   = CFrame.new(newPos, newPos + HRP.CFrame.LookVector)
                firstJump = false  -- disable after first jump

                HRP.CFrame = newCF
                HRP.AssemblyLinearVelocity  = Vector3.zero
                HRP.AssemblyAngularVelocity = Vector3.zero

                -- === Hover spam at this position ===
                local hoverStart = os.clock()
                while AutoFarmEnabled
                    and hasOwnLoot()
                    and (os.clock() - hoverStart  < 1.7)
                    and (os.clock() - cycleStart  < MaxCycleTime) do

                    Character = LocalPlayer.Character
                    HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                    if HRP then
                        HRP.CFrame = newCF
                        HRP.AssemblyLinearVelocity  = Vector3.zero
                        HRP.AssemblyAngularVelocity = Vector3.zero
                    end
                    task.wait(0)
                end
            end

            -- === 4. Cleanup & return to Split ===
            StopAutoLoot()

            local Character = LocalPlayer.Character
            local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
            local hum   = Character and Character:FindFirstChildOfClass("Humanoid")

            if not (HRP and splitPart) then
                task.wait(0.5)
                -- still try to sell even if we couldn't position correctly
                pcall(function()
                    game:GetService("ReplicatedStorage").Remotes.SellRequest:FireServer({Mode = "SellAll"})
                end)
                ProcessedModels = {}
                task.wait(2.8)
                return  -- or continue — depending on your loop logic
            end

            -- Nudge backwards to break any sticking / position lock
            local backOffset = splitPart.CFrame.LookVector * -3  -- slightly bigger nudge usually better
            HRP.CFrame = splitPart.CFrame + Vector3.new(0, 5, 0) + backOffset
            HRP.AssemblyLinearVelocity = Vector3.zero
            HRP.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.06)

            -- Snap to split
            local basePos = splitPart.CFrame + Vector3.new(0, 5, 0)
            HRP.CFrame = basePos
            HRP.AssemblyLinearVelocity = Vector3.zero
            HRP.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.08)

            -- Wiggle / server position validation spam
            for i = 1, 12 do
                HRP.CFrame = basePos + Vector3.new(0, 0,  1.8)   -- forward
                task.wait(0.032)
                HRP.CFrame = basePos + Vector3.new(0, 0, -1.8)   -- back
                task.wait(0.032)
            end

            -- Optional: tiny up/down if game checks grounded state
            -- for i = 1, 4 do
            --     HRP.CFrame = basePos + Vector3.new(0, 0.6, 0)
            --     task.wait(0.04)
            --     HRP.CFrame = basePos
            --     task.wait(0.04)
            -- end

            -- Final settle + small delay before sell
            HRP.CFrame = basePos
            HRP.AssemblyLinearVelocity = Vector3.zero
            HRP.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.12)   -- ← increased slightly

            -- Sell
            task.wait(0.4)    -- most games need 0.3–0.7s after movement before sell registers
            pcall(function()
                game:GetService("ReplicatedStorage").Remotes.SellRequest:FireServer({Mode = "SellAll"})
            end)

            ProcessedModels = {}
            task.wait(2.8)
        end
    end)
end

